{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "antena",
  "version": "0.10.0",
  "identifier": "es.egdev.antena",
  "build": {
    "frontendDist": "../app/splash",
    "beforeDevCommand": { "script": "pnpm app:build", "wait": true },
    "beforeBuildCommand": "pnpm app:build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ2RkFBNEZCQjUwNTQxMDAKUldRQVFRVzErNlQ2UnJmZTl1MVpMWk9sUE82Skx0ZFRDZHFoNDRjTWlwU0NNYkJ2UzhwT1Z4YWQK",
      "endpoints": ["https://github.com/egdev6/antena/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "EGDEV",
    "shortDescription": "Alertas, chat y control de Meld para los directos de EGDEV",
    "category": "Video",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "externalBin": ["binaries/node"],
    "resources": {
      "../src/": "server/src/",
      "../public/": "server/public/",
      "../app/dist/": "server/app/dist/",
      "../package.json": "server/package.json"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser", "languages": ["Spanish"] }
    }
  }
}
